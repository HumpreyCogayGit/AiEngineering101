# =====================================================================
# AI Engineer Course — configuration
# Copy this file to `.env` (same folder) and fill in your own values:
#     cp .env.example .env
# `.env` is git-ignored. NEVER commit real keys.
# See Lecture/setup.html for step-by-step instructions.
# =====================================================================

# --- Which inference provider runs the models? -------------------------
#   azure   Azure Foundry (Azure OpenAI), in the cloud. Fill in the AZURE_OPENAI_* block.
#   ollama  Ollama, on your own machine: free and offline. See the OLLAMA_* block.
# Only the block of the provider you pick is read. Switch any time by changing this line.
AICOURSE_PROVIDER=azure

# --- Provider: Azure Foundry (Azure OpenAI) ----------------------------
# The endpoint of your Azure Foundry / Azure OpenAI resource.
# Find it in the Foundry portal: your model deployment -> "Endpoint".
# Just the base URL is enough, for example:
#   https://my-resource.openai.azure.com
#   https://my-resource.services.ai.azure.com
#   https://my-resource.cognitiveservices.azure.com
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com

# The API key shown next to the endpoint ("Key 1" or "Key 2").
AZURE_OPENAI_API_KEY=paste-your-key-here

# The DEPLOYMENT NAME of your chat model (the name you chose when deploying,
# not necessarily the model name). Recommended model: gpt-4.1-mini — it supports
# tool calling, structured output, image input and the temperature parameter.
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1-mini

# The DEPLOYMENT NAME of your embedding model (needed from EXER019 / RAG onward).
# Recommended model: text-embedding-3-small
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# --- Provider: Ollama (local models) ------------------------------------
# Install Ollama (https://ollama.com), then download the two models once:
#     ollama pull gemma4:e4b
#     ollama pull nomic-embed-text
# The values below are the defaults: uncomment a line only to change it.

# Where Ollama listens.
# OLLAMA_BASE_URL=http://localhost:11434

# The chat model, by the name `ollama list` shows. It must support tool calling
# and image input (check with `ollama show <model>`): gemma4:e4b does.
# OLLAMA_CHAT_MODEL=gemma4:e4b

# The embedding model (needed from EXER019 / RAG onward).
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest

# Text put in front of every search query / document before it is embedded.
# nomic-embed-text was trained with these prefixes and retrieves poorly without them.
# They belong to the embedding model: for a model that uses none, set both to "".
# OLLAMA_EMBEDDING_QUERY_PREFIX="search_query: "
# OLLAMA_EMBEDDING_DOCUMENT_PREFIX="search_document: "

# A local Ollama needs no key. Set one only for an Ollama behind a gateway that checks it.
# OLLAMA_API_KEY=ollama

# --- Optional ----------------------------------------------------------
# Seconds before a request to the model gives up.
# Default: 60 for azure, 300 for ollama (a local model must load first and answers slower).
# AICOURSE_REQUEST_TIMEOUT=60

# Where Chroma stores its vector databases (relative to the repo root).
# AICOURSE_CHROMA_DIR=.chroma

# LangSmith tracing (EXER035, optional). Get a free key at smith.langchain.com
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=ai-engineer-course

# How much hidden "thinking" a reasoning model does before it answers: none, low, medium, high.
# Leave this unset to let the model decide. Less thinking is faster (a local model answers
# several times quicker with `none`), but a small model then chooses tools noticeably worse:
# with `none`, gemma4:e4b fails the agent checks in EXER017, EXER030 and EXER031.
# AICOURSE_REASONING_EFFORT=low

# Does your chat model accept a custom `temperature`? Leave this unset:
# the course detects it once and remembers. Reasoning models (gpt-5 family,
# o-series) only accept the default temperature; classic models (gpt-4.1) accept 0-2.
# AICOURSE_SUPPORTS_TEMPERATURE=true
